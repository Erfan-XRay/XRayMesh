---
/**
 * What a tunnel does: a client reaches a port on the server the tunnel runs on, and the traffic
 * crosses the mesh to a port on the destination server. Ports and IPs are props, so the same
 * diagram can show a plain forward (443 → 443) or a mapping (1234 → 443).
 */
interface Props {
	listen?: string;
	destIp?: string;
	destPort?: string;
}

const { listen = '443', destIp = '10.144.144.2', destPort = listen } = Astro.props;
const t = Astro.locals.t;
---

<figure class="xr-flow not-content" aria-label={t('xr.tunnel.label')}>
	<div class="xr-flow-node xr-flow-client">
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<circle cx="12" cy="8" r="3.5" fill="none" stroke="currentColor" stroke-width="1.7"></circle>
			<path d="M5 19.5c1.2-3.4 3.8-5 7-5s5.8 1.6 7 5" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
		</svg>
		<strong>{t('xr.tunnel.client')}</strong>
		<small>{t('xr.tunnel.clientSub')}</small>
	</div>

	<div class="xr-flow-wire" aria-hidden="true"><i></i></div>

	<div class="xr-flow-node">
		<span class="xr-flow-role">{t('xr.tunnel.origin')}</span>
		<strong>{t('xr.diagram.serverA')}</strong>
		<code dir="ltr">:{listen}</code>
	</div>

	<div class="xr-flow-wire xr-flow-mesh" aria-hidden="true">
		<i></i>
		<span>{t('xr.tunnel.mesh')}</span>
	</div>

	<div class="xr-flow-node xr-flow-dest">
		<span class="xr-flow-role">{t('xr.tunnel.dest')}</span>
		<strong>{t('xr.diagram.serverB')}</strong>
		<code dir="ltr">{destIp}:{destPort}</code>
	</div>
</figure>

<style>
	.xr-flow {
		margin-block: 1.75rem;
		padding: 1.25rem;
		border: 1px solid var(--xr-border);
		border-radius: var(--xr-radius-lg);
		background:
			radial-gradient(ellipse 70% 90% at 50% 100%, rgb(var(--xr-accent-rgb) / var(--xr-glow)), transparent 70%),
			var(--xr-surface);
		display: flex;
		flex-direction: column;
		align-items: stretch;
		gap: 0;
	}

	.xr-flow-node {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.25rem;
		padding: 0.75rem 1rem;
		border: 1px solid var(--xr-border-strong);
		border-radius: var(--xr-radius);
		background: var(--xr-card);
		box-shadow: var(--xr-shadow);
		text-align: center;
		min-width: 0;
	}

	.xr-flow-node strong {
		color: var(--sl-color-white);
		font-size: var(--sl-text-sm);
	}

	.xr-flow-node small,
	.xr-flow-role {
		font-size: var(--sl-text-2xs);
		color: var(--sl-color-gray-3);
	}

	.xr-flow-role {
		text-transform: uppercase;
		letter-spacing: 0.06em;
		font-weight: 600;
	}

	:global([dir='rtl']) .xr-flow-role {
		text-transform: none;
		letter-spacing: 0;
	}

	.xr-flow-node code {
		font-family: var(--__sl-font-mono);
		font-size: 0.8125rem;
		color: var(--sl-color-text-accent);
		background: rgb(var(--xr-accent-rgb) / 0.1);
		border: 1px solid rgb(var(--xr-accent-rgb) / 0.3);
		border-radius: 0.375rem;
		padding: 0.05rem 0.45rem;
	}

	.xr-flow-client {
		border-style: dashed;
		background: transparent;
		box-shadow: none;
		color: var(--sl-color-gray-2);
	}

	.xr-flow-dest {
		border-color: rgb(var(--xr-accent-rgb) / 0.45);
	}

	.xr-flow-wire {
		position: relative;
		align-self: center;
		width: 2px;
		height: 1.75rem;
		background: var(--xr-border-strong);
		overflow: hidden;
	}

	.xr-flow-wire i {
		position: absolute;
		inset-inline: 0;
		height: 45%;
		background: rgb(var(--xr-accent-rgb));
		animation: xr-flow-v 1.4s linear infinite;
	}

	.xr-flow-mesh {
		width: auto;
		height: 2.75rem;
		overflow: visible;
		background: none;
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}

	.xr-flow-mesh::before {
		content: '';
		position: absolute;
		inset-block: 0;
		inset-inline-start: 50%;
		width: 2px;
		margin-inline-start: -1px;
		background: rgb(var(--xr-accent-rgb) / 0.35);
	}

	.xr-flow-mesh i {
		display: none;
	}

	.xr-flow-mesh span {
		position: relative;
		padding: 0.1rem 0.6rem;
		border-radius: 999px;
		background: var(--xr-surface);
		border: 1px solid rgb(var(--xr-accent-rgb) / 0.4);
		font-size: var(--sl-text-2xs);
		font-weight: 600;
		color: var(--sl-color-text-accent);
	}

	@keyframes xr-flow-v {
		from {
			top: -45%;
		}
		to {
			top: 100%;
		}
	}

	@keyframes xr-flow-h {
		from {
			inset-inline-start: -45%;
		}
		to {
			inset-inline-start: 100%;
		}
	}

	@media (min-width: 42rem) {
		.xr-flow {
			flex-direction: row;
			align-items: center;
		}

		.xr-flow-node {
			flex: 1 1 0;
		}

		.xr-flow-client {
			flex: 0.8 1 0;
		}

		.xr-flow-wire {
			width: 2.25rem;
			height: 2px;
			flex-shrink: 0;
		}

		.xr-flow-wire i {
			inset-inline: auto;
			inset-block: 0;
			width: 45%;
			height: auto;
			animation-name: xr-flow-h;
		}

		.xr-flow-mesh {
			width: 5.5rem;
			height: auto;
			justify-content: center;
		}

		.xr-flow-mesh::before {
			inset-inline: 0;
			inset-block-start: 50%;
			width: auto;
			height: 2px;
			margin: -1px 0 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.xr-flow-wire i {
			animation: none;
			opacity: 0;
		}
	}
</style>

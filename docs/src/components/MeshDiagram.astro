---
/**
 * How XRayMesh fits together: two servers, each with its own panel, joined by one encrypted mesh.
 * Built from HTML (not SVG) so labels wrap and follow the page direction.
 */
const t = Astro.locals.t;
const servers = [
	{ name: t('xr.diagram.serverA'), vip: '10.144.144.1' },
	{ name: t('xr.diagram.serverB'), vip: '10.144.144.2' },
];
---

<figure class="xr-diagram not-content" aria-label={t('xr.diagram.label')}>
	<div class="xr-diagram-user">
		<svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
			<rect x="3" y="4" width="18" height="13" rx="2.5" fill="none" stroke="currentColor" stroke-width="1.7"></rect>
			<path d="M8 20h8M12 17v3" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path>
		</svg>
		<span>{t('xr.diagram.you')}</span>
	</div>
	<div class="xr-diagram-drop" aria-hidden="true">
		<span>HTTPS</span>
	</div>
	<div class="xr-diagram-row">
		{
			servers.map((server, i) => (
				<>
					{i === 1 && (
						<div class="xr-diagram-link">
							<span class="xr-diagram-wire" aria-hidden="true">
								<i />
							</span>
							<strong>{t('xr.diagram.link')}</strong>
							<small>{t('xr.diagram.linkSub')}</small>
						</div>
					)}
					<div class="xr-diagram-server">
						<div class="xr-diagram-server-head">
							<span class="xr-dot" aria-hidden="true" />
							<strong>{server.name}</strong>
						</div>
						<dl>
							<div>
								<dt>VIP</dt>
								<dd>
									<bdi dir="ltr">{server.vip}</bdi>
								</dd>
							</div>
							<div>
								<dt>{t('xr.diagram.panel')}</dt>
								<dd>
									<bdi dir="ltr">:11080</bdi>
								</dd>
							</div>
						</dl>
					</div>
				</>
			))
		}
	</div>
</figure>

<style>
	.xr-diagram {
		margin-block: 1.75rem;
		padding: 1.5rem;
		border: 1px solid var(--xr-border);
		border-radius: var(--xr-radius-lg);
		background:
			radial-gradient(ellipse 60% 80% at 50% 100%, rgb(var(--xr-accent-rgb) / var(--xr-glow)), transparent 70%),
			var(--xr-surface);
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.xr-diagram-user {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.875rem;
		border: 1px solid var(--xr-border-strong);
		border-radius: 999px;
		background: var(--xr-card);
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}

	.xr-diagram-drop {
		position: relative;
		height: 2.5rem;
		width: 1px;
		background: linear-gradient(var(--xr-border-strong), rgb(var(--xr-accent-rgb) / 0.6));
	}

	.xr-diagram-drop span {
		position: absolute;
		inset-inline-start: 0.625rem;
		top: 50%;
		transform: translateY(-50%);
		font-family: var(--__sl-font-mono);
		font-size: 0.6875rem;
		color: var(--sl-color-gray-3);
	}

	.xr-diagram-row {
		display: grid;
		grid-template-columns: minmax(0, 1fr);
		gap: 0.75rem;
		width: 100%;
		align-items: center;
	}

	.xr-diagram-server {
		padding: 0.875rem 1rem;
		border: 1px solid var(--xr-border-strong);
		border-radius: var(--xr-radius);
		background: var(--xr-card);
		box-shadow: var(--xr-shadow);
	}

	.xr-diagram-server-head {
		display: flex;
		align-items: center;
		gap: 0.5rem;
		color: var(--sl-color-white);
	}

	.xr-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: rgb(var(--xr-success-rgb));
		box-shadow: 0 0 0 3px rgb(var(--xr-success-rgb) / 0.18);
	}

	.xr-diagram-server dl {
		margin: 0.625rem 0 0;
		display: grid;
		gap: 0.25rem;
		font-size: var(--sl-text-xs);
	}

	.xr-diagram-server dl > div {
		display: flex;
		justify-content: space-between;
		gap: 1rem;
	}

	.xr-diagram-server dt {
		color: var(--sl-color-gray-3);
	}

	.xr-diagram-server dd {
		margin: 0;
		font-family: var(--__sl-font-mono);
		color: var(--sl-color-gray-1);
	}

	.xr-diagram-link {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		gap: 0.125rem;
		padding-block: 0.25rem;
	}

	.xr-diagram-link strong {
		font-size: var(--sl-text-sm);
		color: var(--sl-color-text-accent);
	}

	.xr-diagram-link small {
		font-size: var(--sl-text-2xs);
		color: var(--sl-color-gray-3);
		max-width: 12rem;
	}

	.xr-diagram-wire {
		position: relative;
		display: block;
		width: 2px;
		height: 2rem;
		margin-block-end: 0.375rem;
		border-radius: 2px;
		background: rgb(var(--xr-accent-rgb) / 0.25);
		overflow: hidden;
	}

	.xr-diagram-wire i {
		position: absolute;
		inset-inline: 0;
		height: 40%;
		border-radius: 2px;
		background: rgb(var(--xr-accent-rgb));
		animation: xr-wire-v 1.6s linear infinite;
	}

	@keyframes xr-wire-v {
		from {
			top: -40%;
		}
		to {
			top: 100%;
		}
	}

	@keyframes xr-wire-h {
		from {
			inset-inline-start: -40%;
		}
		to {
			inset-inline-start: 100%;
		}
	}

	@media (min-width: 40rem) {
		.xr-diagram-row {
			grid-template-columns: minmax(0, 1fr) minmax(9rem, 0.8fr) minmax(0, 1fr);
		}

		.xr-diagram-wire {
			width: 100%;
			height: 2px;
			margin-block-end: 0.5rem;
		}

		.xr-diagram-wire i {
			inset-inline: auto;
			top: 0;
			bottom: 0;
			width: 40%;
			height: auto;
			animation-name: xr-wire-h;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.xr-diagram-wire i {
			animation: none;
			inset-inline-start: 30%;
		}
	}
</style>
